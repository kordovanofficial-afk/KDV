[
  {
    "name": "theme_info",
    "theme_name": "Kordovan",
    "theme_version": "1.0.0",
    "theme_author": "Kordovan Leather",
    "theme_documentation_url": "https://kordovanleather.com",
    "theme_support_url": "https://kordovanleather.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (Cognac)",
        "default": "#A0623A"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (Gold)",
        "default": "#B0894F"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#F7F2EA"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Body text",
        "default": "#241C16"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "playfair_display_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "inter_n4"
      }
    ]
  },
  {
    "name": "Contact & Social",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number (international format)",
        "placeholder": "923332601161",
        "info": "Include country code without +. E.g. 923332601161"
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "WhatsApp default message",
        "default": "Hi! I have a question about your products."
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube URL"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer_enabled",
        "label": "Enable cart drawer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "free_shipping_bar",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (PKR, no commas)",
        "default": "3000"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Square transparent .png, 512 x 512px. Used for the browser tab and the iOS home-screen icon."
      }
    ]
  },
  {
    "name": "Order tracking",
    "settings": [
      {
        "type": "text",
        "id": "tracking_api_url",
        "label": "Live tracking API (Cloudflare Worker)",
        "info": "Full URL of the Worker's /track endpoint, e.g. https://kordovan-postex-sync.<subdomain>.workers.dev/track \u2014 when set, status shows in a popup instead of redirecting."
      },
      {
        "type": "text",
        "id": "courier_name",
        "label": "Courier name",
        "default": "PostEx",
        "info": "Shown on the Track Your Order page."
      },
      {
        "type": "text",
        "id": "courier_tracking_url",
        "label": "Courier tracking URL",
        "info": "Paste your courier's public tracking URL and put {number} where the tracking number goes, e.g. https://example.com/track?cn={number}. Leave blank and the form hands off to WhatsApp instead."
      }
    ]
  }
]
