{%- comment -%}
  Stats are hardcoded (not blocks) because Shopify's theme editor strips block
  settings from templates/index.json on sync. Cross-referenced to homepage-final.html.
{%- endcomment -%}
{%- liquid
  assign story_img = 'https://cdn.shopify.com/s/files/1/0267/9164/1277/files/story-craft.png?v=1782025665&width=1100'
  if section.settings.image != blank
    assign story_img = section.settings.image | image_url: width: 1100
  endif
-%}

<section class="kv-home kv-section kv-story">
  <div class="kv-wrap kv-story__g">
    <div class="kv-story__img" style="background-image:url('{{ story_img }}')">
      <span class="kv-story__badge">{{ section.settings.badge | default: 'Handmade in Pakistan' }}</span>
    </div>
    <div>
      <span class="kv-eyebrow">{{ section.settings.eyebrow | default: 'Our Story' }}</span>
      <h2>{{ section.settings.title | default: 'Craft That Speaks for Itself' }}</h2>

      {%- if section.settings.text != blank -%}
        {{ section.settings.text }}
      {%- else -%}
        <p>Kordovan began with a simple belief: a wallet should outlive its trends. We work full-grain leather by hand in Pakistan — cut, stitched, and finished to age into something better with every year you carry it.</p>
        <p>No fast fashion. No corners cut. Just leather built to be handed down.</p>
      {%- endif -%}

      <div class="kv-story__stats">
        <div><div class="n">25K+</div><div class="l">Happy Customers</div></div>
        <div><div class="n">5+</div><div class="l">Years of Craft</div></div>
        <div><div class="n">100%</div><div class="l">Genuine Leather</div></div>
      </div>

      <a class="kv-btn-text" href="{{ section.settings.cta_url | default: '/pages/about' }}">{{ section.settings.cta_text | default: 'Read Our Story' }} →</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Story image", "info": "Defaults to story-craft.png if empty." },
    { "type": "text", "id": "badge", "label": "Image badge", "default": "Handmade in Pakistan" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Craft That Speaks for Itself" },
    { "type": "richtext", "id": "text", "label": "Story text" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Read Our Story" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ]
}
{% endschema %}
