<section class="email-capture">
  <div class="container">
    <div class="email-capture__inner">
      <p class="eyebrow">{{ section.settings.eyebrow | default: 'Join the Kordovan Family' }}</p>
      <h2 class="email-capture__title">{{ section.settings.title | default: 'Get 10% Off Your First Order' }}</h2>
      <p class="email-capture__subtitle">{{ section.settings.subtitle | default: 'Join 15,000+ leather lovers who get early access to new drops, exclusive offers, and care tips straight to their inbox.' }}</p>

      {%- form 'customer', id: 'email-signup-form', class: 'email-capture__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="email-signup-input" class="visually-hidden">Email address</label>
        <input
          type="email"
          name="contact[email]"
          id="email-signup-input"
          class="email-capture__input"
          placeholder="{{ section.settings.placeholder | default: 'Your email address' }}"
          required
          autocomplete="email"
        >
        <button type="submit" class="email-capture__submit">
          {{ section.settings.button_text | default: 'Claim Discount' }}
        </button>
      {%- endform -%}

      <p class="email-capture__disclaimer">{{ section.settings.disclaimer | default: 'No spam. Unsubscribe anytime. We hate junk mail too.' }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Email Signup",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the Kordovan Family" },
    { "type": "text", "id": "title", "label": "Title", "default": "Get 10% Off Your First Order" },
    { "type": "text", "id": "subtitle", "label": "Subtitle" },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Claim Discount" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer text" }
  ],
  "presets": [
    {
      "name": "Email Signup"
    }
  ]
}
{% endschema %}
