{%- comment -%}
  Footer — 1:1 with homepage-final.html. Content hardcoded for pixel-exactness
  (links/contact), with social URLs + copy overridable via settings.
{%- endcomment -%}
{%- liquid
  assign ig = section.settings.instagram_url | default: 'https://www.instagram.com/kordovan.leather'
  assign fb = section.settings.facebook_url | default: 'https://www.facebook.com/kordovan.leather'
  assign yt = section.settings.youtube_url | default: 'https://www.youtube.com/@kordovanleather8072'
  assign tt = section.settings.tiktok_url | default: 'https://www.tiktok.com/@kordovan.leather'
  assign wa = section.settings.whatsapp_number | default: '923332601161'
  assign phone = section.settings.phone | default: '+92 333 2601161'
  assign email = section.settings.email | default: 'kordovan.official@gmail.com'
-%}

<footer class="kv-ftr" role="contentinfo">
  <div class="kv-ftr__inner kv-wrap">
    <div class="kv-stitch"></div>
    <div class="kv-ftr__head">

      <div class="kv-fbrand">
        <div class="kv-eyebrow">Est. 2020 · Made in Pakistan</div>
        <div class="kv-credo">{{ section.settings.credo | default: 'Leather, <em>built to be handed down.</em>' }}</div>
        <div class="kv-fsocial">
          <a href="{{ ig }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
          <a href="{{ fb }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M15 3h-3a4 4 0 0 0-4 4v3H5v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
          <a href="{{ yt }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3z" fill="var(--brass-light)" stroke="none"/></svg></a>
          <a href="{{ tt }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M16 4c.5 2.5 2 4 4.5 4.2V11c-1.7 0-3.3-.5-4.5-1.3V15a5.5 5.5 0 1 1-5.5-5.5c.3 0 .6 0 .9.1v2.8a2.7 2.7 0 1 0 1.9 2.6V4z"/></svg></a>
        </div>
      </div>

      <div class="kv-fcol">
        <h4>Shop</h4>
        <ul>
          <li><a href="{{ routes.collections_url }}/kdv-wallets">Wallets</a></li>
          <li><a href="{{ routes.collections_url }}/kdv-bags">Bags</a></li>
          <li><a href="{{ routes.collections_url }}/kdv-jackets">Jackets</a></li>
          <li><a href="{{ routes.collections_url }}/kdv-shoes">Shoes</a></li>
          <li><a href="{{ routes.collections_url }}/kdv-belts">Belts</a></li>
          <li><a href="{{ routes.collections_url }}/kdv-accessories">Accessories</a></li>
        </ul>
      </div>

      <div class="kv-fcol">
        <h4>Help</h4>
        <ul>
          <li><a href="/pages/shipping">Shipping &amp; Delivery</a></li>
          <li><a href="/pages/returns">Returns &amp; Exchanges</a></li>
          <li><a href="/pages/leather-care-guide">Leather Care Guide</a></li>
          <li><a href="{{ routes.account_url }}">Track Your Order</a></li>
          <li><a href="/pages/about-kordovan">Our Story</a></li>
        </ul>
      </div>

      <div class="kv-fconnect">
        <h4>Get in Touch</h4>
        <a class="kv-fwa" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2s-1.2.2-3.8-.9-4.1-3.7-4.2-3.9-1-1.3-1-2.5.6-1.7.9-1.9.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.6c-.2.2-.3.4-.1.7s.7 1.2 1.5 1.9c1 .9 1.8 1.1 2.1 1.3s.4.1.6-.1l.7-.8c.2-.3.4-.2.6-.1l1.8.9c.2.1.4.2.4.3z"/></svg>Chat on WhatsApp</a>
        <p><a href="tel:{{ phone | replace: ' ', '' }}">{{ phone }}</a> · call or WhatsApp<br><a href="mailto:{{ email }}">{{ email }}</a></p>
        <p class="addr"><svg viewBox="0 0 24 24"><path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>{{ section.settings.address | default: 'G4, Falcon Street Mall,<br>Malir Cantt, Karachi' }}</p>
        <p class="hours">{{ section.settings.hours | default: 'Support · 11am – 8pm PKT' }}</p>
      </div>
    </div>

    <div class="kv-ftr__bottom">
      <span class="kv-fcopy">© {{ 'now' | date: '%Y' }} {{ shop.name }} · Handcrafted in Pakistan 🇵🇰</span>
      <div class="kv-fpay"><span>Cash on Delivery</span><span>Visa</span><span>Mastercard</span><span>Easypaisa</span><span>JazzCash</span></div>
      <a class="kv-ftop" href="#">Back to top <svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7"/></svg></a>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "html", "id": "credo", "label": "Credo (supports <em>)", "default": "Leather, <em>built to be handed down.</em>" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (digits only)", "default": "923332601161" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+92 333 2601161" },
    { "type": "text", "id": "email", "label": "Email", "default": "kordovan.official@gmail.com" },
    { "type": "html", "id": "address", "label": "Address (supports <br>)", "default": "G4, Falcon Street Mall,<br>Malir Cantt, Karachi" },
    { "type": "text", "id": "hours", "label": "Support hours", "default": "Support · 11am – 8pm PKT" }
  ]
}
{% endschema %}
