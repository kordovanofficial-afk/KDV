{%- comment -%}
  Shared content-page template (About, Shipping, Leather Care, Returns, Our Craft,
  FAQs, etc.). On-brand editorial layout; styling lives in assets/home.css (.kv-page).
  Specific handles get a bespoke designed layout (rendered via snippet) so we stay
  theme-local and never alter the page's template suffix (which is store-wide).
{%- endcomment -%}
{%- if page.handle == 'about-kordovan' -%}
  {%- render 'our-story' -%}
{%- else -%}
<div class="kv-page">
  <div class="kv-page__hero">
    <div class="kv-wrap">
      {%- if section.settings.eyebrow != blank -%}
        <span class="kv-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1>{{ page.title }}</h1>
    </div>
  </div>

  <div class="kv-page__body">
    <div class="kv-rte">
      {{ page.content }}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (above title)", "info": "Optional small label shown above the page title." }
  ],
  "presets": [{ "name": "Page" }]
}
{% endschema %}
