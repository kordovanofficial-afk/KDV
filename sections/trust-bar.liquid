<div class="trust-bar">
  <div class="trust-bar__marquee">
    <ul class="trust-bar__track" role="list">
      {%- for block in section.blocks -%}
        <li class="trust-bar__item" {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
              </svg>
            {%- when 'shield' -%}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            {%- when 'award' -%}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
              </svg>
            {%- when 'refresh' -%}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.95"/>
              </svg>
            {%- when 'heart' -%}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            {%- when 'check' -%}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            {%- else -%}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/><polyline points="12 8 12 12 14 14"/>
              </svg>
          {%- endcase -%}
          <span class="trust-bar__text">{{ block.settings.text }}</span>
        </li>
        <li class="trust-bar__sep" aria-hidden="true">&#8212;</li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery truck" },
            { "value": "shield", "label": "Shield / Security" },
            { "value": "award", "label": "Award / Quality" },
            { "value": "refresh", "label": "Returns" },
            { "value": "heart", "label": "Heart" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Free delivery over PKR 3,000" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "truck", "text": "Free Delivery over PKR 3,000" } },
        { "type": "trust_item", "settings": { "icon": "award", "text": "Genuine Leather Guaranteed" } },
        { "type": "trust_item", "settings": { "icon": "shield", "text": "RFID Protected Wallets" } },
        { "type": "trust_item", "settings": { "icon": "refresh", "text": "7-Day Easy Returns" } },
        { "type": "trust_item", "settings": { "icon": "heart", "text": "Handcrafted in Pakistan" } }
      ]
    }
  ]
}
{% endschema %}
