{%- comment -%} Thin wrapper — PDP body lives in snippets/pdp-main.liquid (sync workaround). {%- endcomment -%}
{% render 'pdp-main' %}

{% schema %}
{
  "name": "Product",
  "blocks": [
    {
      "type": "feature_pill",
      "name": "Feature Pill",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "shield", "label": "Shield" },
          { "value": "award", "label": "Award" },
          { "value": "check", "label": "Checkmark" },
          { "value": "droplet", "label": "Droplet" } ], "default": "check" },
        { "type": "text", "id": "text", "label": "Text", "default": "Genuine Leather" }
      ]
    }
  ],
  "presets": [ { "name": "Product" } ]
}
{% endschema %}
