{%- comment -%}
  Editorial 5-tile category grid. Handles/images are hardcoded here (NOT in the JSON
  template) because Shopify's theme editor strips block settings on sync. Counts are
  live via collection.all_products_count. Cross-referenced to homepage-final.html.
{%- endcomment -%}
{%- liquid
  assign cdn = 'https://cdn.shopify.com/s/files/1/0267/9164/1277/files/'
  assign sm_handles = 'kdv-bags,kdv-jackets,kdv-shoes,kdv-belts' | split: ','
  assign sm_labels  = 'Bags,Jackets,Shoes,Belts' | split: ','
  assign sm_imgs    = 'coll-bags.png,coll-jackets.png,coll-shoes.png,coll-belts.png' | split: ','
  assign wallets    = collections['kdv-wallets']
-%}

<section class="kv-home kv-section">
  <div class="kv-wrap">
    <div class="kv-shead">
      <span class="kv-eyebrow">{{ section.settings.eyebrow | default: 'Collections' }}</span>
      <h2>{{ section.settings.title | default: 'Shop by Category' }}</h2>
    </div>

    <div class="kv-colls">
      <a class="kv-coll kv-coll--lg" href="{{ wallets.url | default: '/collections/kdv-wallets' }}">
        <img class="kv-coll__img" src="{{ cdn }}coll-wallets.png?v=1782029619&width=1100" alt="Wallets" loading="lazy">
        <div class="kv-coll__g"></div>
        <div class="kv-coll__c">
          <h3>Wallets</h3>
          <div class="kv-coll__ct">{{ wallets.all_products_count }} styles · incl. KODO smart wallets</div>
          <span class="kv-coll__lk">Shop Wallets <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </div>
      </a>

      {%- for handle in sm_handles -%}
        {%- assign coll = collections[handle] -%}
        {%- assign label = sm_labels[forloop.index0] -%}
        <a class="kv-coll" href="{{ coll.url | default: '/collections/' | append: handle }}">
          <img class="kv-coll__img" src="{{ cdn }}{{ sm_imgs[forloop.index0] }}?v=1782029619&width=760" alt="{{ label }}" loading="lazy">
          <div class="kv-coll__g"></div>
          <div class="kv-coll__c">
            <h3>{{ label }}</h3>
            <div class="kv-coll__ct">{{ coll.all_products_count }} styles</div>
            <span class="kv-coll__lk">Shop {{ label }} <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Collections" },
    { "type": "text", "id": "title", "label": "Section title", "default": "Shop by Category" }
  ]
}
{% endschema %}
