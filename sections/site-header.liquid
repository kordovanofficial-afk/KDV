{%- liquid
  assign is_home = false
  if template.name == 'index'
    assign is_home = true
  endif
-%}

<header class="kv-hdr{% unless is_home %} kv-hdr--page{% endunless %}" id="kv-hdr">
  <div class="kv-announce">
    Free delivery over <b>PKR 2,500</b> &nbsp;·&nbsp; Cash on delivery nationwide &nbsp;·&nbsp; 100% genuine leather
  </div>
  <div class="kv-hdr__bar">
  <div class="kv-wrap kv-hdr__row">

    <a href="{{ routes.root_url }}" class="kv-logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo -%}
        <img class="kv-logo--mark{% unless section.settings.logo_light %} kv-logo--auto{% endunless %}"
             src="{{ section.settings.logo | image_url: width: 320 }}"
             alt="{{ shop.name }} logo"
             width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" loading="eager">
      {%- else -%}{{ shop.name }}{%- endif -%}
    </a>

    <ul class="kv-nav">
      <li><a href="{{ routes.collections_url }}/new-arrivals">New Arrivals</a></li>

      <li><a href="{{ routes.collections_url }}/wallets">Wallets <svg class="kv-car" viewBox="0 0 10 6"><path d="M1 1l4 4 4-4"/></svg></a>
        <div class="kv-drop"><div class="kv-wrap kv-mega__in">
          <div class="kv-mcol"><h5>Men's Wallets</h5><ul><li><a href="{{ routes.collections_url }}/mens-leather-wallets">Bifold Wallets</a></li><li><a href="{{ routes.collections_url }}/mens-leather-wallets">Cardholders</a></li><li><a href="{{ routes.collections_url }}/mens-leather-wallets">Money Clips</a></li><li><a href="{{ routes.collections_url }}/mens-leather-wallets">Long Wallets</a></li></ul></div>
          <div class="kv-mcol"><h5>Women's Wallets</h5><ul><li><a href="{{ routes.collections_url }}/womens-leather-wallets">Zip Wallets</a></li><li><a href="{{ routes.collections_url }}/womens-leather-wallets">Clutches</a></li><li><a href="{{ routes.collections_url }}/womens-leather-wallets">Cardholders</a></li></ul></div>
          <div class="kv-mcol"><h5>Smart — KODO</h5><ul><li><a href="{{ routes.collections_url }}/kodo-by-kordovan">RFID Smart Wallets</a></li><li><a href="{{ routes.collections_url }}/kodo-by-kordovan">KODO Black</a></li><li><a href="{{ routes.collections_url }}/kodo-by-kordovan">KODO Brown</a></li></ul></div>
          <a class="kv-mfeat" href="{{ routes.all_products_collection_url }}"><img src="https://cdn.shopify.com/s/files/1/0267/9164/1277/files/KODO.png?v=1782021735&width=560" style="object-position:50% 34%" alt="KODO Smart Wallet"><div class="kv-g"></div><div class="kv-c"><div class="kv-tag">Pakistan's First RFID Wallet</div><h4>The KODO Smart Wallet</h4><span class="kv-lk">Shop the KODO →</span></div></a>
        </div></div>
      </li>

      <li><a href="{{ routes.collections_url }}/bags">Bags <svg class="kv-car" viewBox="0 0 10 6"><path d="M1 1l4 4 4-4"/></svg></a>
        <div class="kv-drop"><div class="kv-wrap kv-simple__in">
          <div class="kv-mcol"><h5>By Type</h5><ul><li><a href="{{ routes.collections_url }}/womens-leather-handbags">Handbags &amp; Totes</a></li><li><a href="{{ routes.collections_url }}/bags">Laptop &amp; Travel Bags</a></li><li><a href="{{ routes.collections_url }}/bags">Messenger Bags</a></li></ul></div>
          <div class="kv-mcol"><h5>Shop</h5><ul><li><a href="{{ routes.collections_url }}/womens-leather-handbags">Women's Bags</a></li><li><a href="{{ routes.collections_url }}/bags">Men's Bags</a></li><li><a href="{{ routes.collections_url }}/bags">View all Bags</a></li></ul></div>
        </div></div>
      </li>

      <li><a href="{{ routes.collections_url }}/mens-leather-jackets">Jackets <svg class="kv-car" viewBox="0 0 10 6"><path d="M1 1l4 4 4-4"/></svg></a>
        <div class="kv-drop"><div class="kv-wrap kv-mega__in">
          <div class="kv-mcol"><h5>Men's Jackets</h5><ul><li><a href="{{ routes.collections_url }}/mens-leather-jackets">Biker Jackets</a></li><li><a href="{{ routes.collections_url }}/mens-leather-jackets">Bomber Jackets</a></li><li><a href="{{ routes.collections_url }}/mens-leather-jackets">Racer Jackets</a></li></ul></div>
          <div class="kv-mcol"><h5>Women's Jackets</h5><ul><li><a href="{{ routes.collections_url }}/womens-leather-jackets">Biker Jackets</a></li><li><a href="{{ routes.collections_url }}/womens-leather-jackets">Blazers</a></li></ul></div>
          <div class="kv-mcol"><h5>By Leather</h5><ul><li><a href="{{ routes.collections_url }}/mens-leather-jackets">Cowhide</a></li><li><a href="{{ routes.collections_url }}/mens-leather-jackets">Sheep / Nappa</a></li><li><a href="{{ routes.collections_url }}/mens-leather-jackets">Suede</a></li></ul></div>
          <a class="kv-mfeat" href="{{ routes.collections_url }}/mens-leather-jackets"><img src="https://cdn.shopify.com/s/files/1/0267/9164/1277/files/Jacket.png?v=1782021735&width=560" alt="Men's Leather Jackets"><div class="kv-g"></div><div class="kv-c"><div class="kv-tag">Heirloom Outerwear</div><h4>Men's Leather Jackets</h4><span class="kv-lk">Shop jackets →</span></div></a>
        </div></div>
      </li>

      <li><a href="{{ routes.collections_url }}/mens-leather-shoes">Shoes <svg class="kv-car" viewBox="0 0 10 6"><path d="M1 1l4 4 4-4"/></svg></a>
        <div class="kv-drop"><div class="kv-wrap kv-simple__in">
          <div class="kv-mcol"><h5>By Style</h5><ul><li><a href="{{ routes.collections_url }}/mens-leather-shoes">Oxfords</a></li><li><a href="{{ routes.collections_url }}/mens-leather-shoes">Brogues</a></li><li><a href="{{ routes.collections_url }}/mens-leather-shoes">Loafers &amp; Moccasins</a></li><li><a href="{{ routes.collections_url }}/mens-leather-shoes">Boots</a></li></ul></div>
          <div class="kv-mcol"><h5>Shop</h5><ul><li><a href="{{ routes.collections_url }}/mens-leather-shoes">New Shoes</a></li><li><a href="{{ routes.collections_url }}/mens-leather-shoes">View all Shoes</a></li></ul></div>
        </div></div>
      </li>

      <li><a href="{{ routes.collections_url }}/accessories">Accessories <svg class="kv-car" viewBox="0 0 10 6"><path d="M1 1l4 4 4-4"/></svg></a>
        <div class="kv-drop"><div class="kv-wrap kv-simple__in">
          <div class="kv-mcol"><h5>Small Goods</h5><ul><li><a href="{{ routes.collections_url }}/mens-leather-belts">Belts</a></li><li><a href="{{ routes.collections_url }}/accessories">Gloves</a></li><li><a href="{{ routes.collections_url }}/accessories">Caps &amp; Hats</a></li></ul></div>
          <div class="kv-mcol"><h5>More</h5><ul><li><a href="{{ routes.collections_url }}/accessories">Cigarette Cases</a></li><li><a href="{{ routes.collections_url }}/accessories">Folios &amp; Notebooks</a></li><li><a href="{{ routes.collections_url }}/accessories">Lipstick Cases</a></li></ul></div>
        </div></div>
      </li>

      <li class="kv-sale"><a href="{{ routes.collections_url }}/sale">Sale</a></li>
    </ul>

    <div class="kv-actions">
      <a class="kv-search" href="{{ routes.search_url }}" aria-label="Search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></a>
      <a class="kv-acct" href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></a>
      <a class="kv-cart" href="{{ routes.cart_url }}" aria-label="Cart ({{ cart.item_count }})"><svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg><i style="display:{% if cart.item_count > 0 %}flex{% else %}none{% endif %}">{{ cart.item_count }}</i></a>
      <button class="kv-burger" aria-label="Open menu" onclick="document.getElementById('kv-mm').classList.add('kv-open')"><span></span><span></span><span></span></button>
    </div>
  </div>
  </div>
</header>

<div class="kv-mmenu" id="kv-mm">
  <div class="kv-mmenu__top">
    <span class="kv-logo" style="color:var(--canvas)">{{ shop.name }}</span>
    <button class="kv-mclose" aria-label="Close menu" onclick="document.getElementById('kv-mm').classList.remove('kv-open')">&times;</button>
  </div>
  <a href="{{ routes.collections_url }}/new-arrivals">New Arrivals</a>
  <a href="{{ routes.collections_url }}/wallets">Wallets</a>
  <a href="{{ routes.collections_url }}/bags">Bags</a>
  <a href="{{ routes.collections_url }}/mens-leather-jackets">Jackets</a>
  <a href="{{ routes.collections_url }}/mens-leather-shoes">Shoes</a>
  <a href="{{ routes.collections_url }}/accessories">Accessories</a>
  <a href="{{ routes.collections_url }}/sale" style="color:var(--brass-light)">Sale</a>
</div>

<script>
  (function(){
    var h=document.getElementById('kv-hdr');
    if(h){window.addEventListener('scroll',function(){h.classList.toggle('kv-scrolled',window.scrollY>40);},{passive:true});}
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (dark mark)", "info": "Your black horse mark. Auto-inverts to cream over the transparent homepage header." },
    { "type": "image_picker", "id": "logo_light", "label": "Logo (light variant — optional)" }
  ]
}
{% endschema %}
