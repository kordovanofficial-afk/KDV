<script>
  (function(){
    var h=document.getElementById('kv-hdr'), a=document.getElementById('kv-announce');
    if(!h) return;
    var home = !h.classList.contains('kv-hdr--page');
    function pos(){
      var ah = a ? a.offsetHeight : 0;
      if(home){
        if(window.scrollY > ah){ h.classList.add('kv-scrolled'); h.style.top='0px'; }
        else { h.classList.remove('kv-scrolled'); h.style.top = ah + 'px'; }
      } else {
        h.classList.toggle('kv-scrolled', window.scrollY > 10);
      }
    }
    window.addEventListener('scroll', pos, {passive:true});
    window.addEventListener('resize', pos);
    pos();
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (dark mark)", "info": "Your black horse mark. Auto-inverts to cream over the transparent homepage header." },
    { "type": "image_picker", "id": "logo_light", "label": "Logo (light variant — optional)" }
  ]
}
{% endschema %}
