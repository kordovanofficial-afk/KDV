{%- comment -%}
  Cart drawer — Quiet Heritage (docs/mockups/cart-drawer.html). Styling in
  assets/home.css (.cart-drawer). Items, free-shipping progress and subtotal are
  rendered live by theme.js CartDrawer; cross-sell is server-rendered below.
  Free-shipping threshold (PKR 5,500) also set in theme.js renderShip().
{%- endcomment -%}
{%- assign xcoll = collections[section.settings.upsell_collection] | default: collections['kdv-accessories'] -%}

<div class="cart-drawer-overlay"></div>
<aside class="cart-drawer" id="cart-drawer" role="dialog" aria-modal="true" aria-label="Shopping cart">

  <div class="cart-drawer__head">
    <h2>Your Cart</h2>
    <button class="cart-drawer__close" aria-label="Close cart">&times;</button>
  </div>

  <!-- free-shipping progress (filled by JS) -->
  <div class="cart-drawer__ship" style="display:none"></div>

  <!-- line items (filled by JS) -->
  <div class="cart-drawer__items">
    <div class="cart-drawer__empty"><p>Your cart is empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="cd__co" style="display:inline-block;width:auto;padding:13px 26px;margin-top:8px;">Start Shopping</a>
    </div>
  </div>

  <!-- cross-sell (one-click; quick-add reuses theme.js .product-card__quick-add) -->
  {%- if xcoll.products.size > 0 -%}
    <div class="cart-drawer__cross" style="display:none">
      <h3>Complete your carry</h3>
      {%- assign n = 0 -%}
      {%- for p in xcoll.products -%}
        {%- if p.available and n < 2 -%}
          <div class="xs">
            <a class="xs__img" href="{{ p.url }}"><img src="{{ p.featured_image | image_url: width: 96 }}" srcset="{{ p.featured_image | image_url: width: 96 }} 96w, {{ p.featured_image | image_url: width: 144 }} 144w" sizes="48px" alt="{{ p.title | escape }}" loading="lazy" decoding="async" width="48" height="58"></a>
            <div class="xs__i"><a href="{{ p.url }}" class="xs__n">{{ p.title }}</a><div class="xs__p">{{ p.price | money }}</div></div>
            {%- if p.variants.size == 1 -%}
              <button class="xs__add product-card__quick-add" data-variant-id="{{ p.selected_or_first_available_variant.id }}">+ Add</button>
            {%- else -%}
              <a class="xs__add" href="{{ p.url }}">+ Add</a>
            {%- endif -%}
          </div>
          {%- assign n = n | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <!-- sticky footer -->
  <div class="cart-drawer__foot">
    <span class="cart-drawer__note">+ Add order note / gift message</span>
    <div class="cd__sub"><span class="l">Subtotal</span><span class="v cart-drawer__total"></span></div>
    {%- comment -%}
      If anything in the cart is made to order, the WHOLE cart is paid online —
      a Shopify Function hides COD and bank transfer, and Shopify cannot split
      payment terms across one order. Say it here, before checkout: a buyer who
      reaches the payment step expecting COD and finds it missing abandons.
      Note the mixed-cart case is deliberate — one made-to-order line makes the
      whole order prepaid, so the wording says "contains", not "is".
    {%- endcomment -%}
    {%- liquid
      assign cart_mto = false
      for it in cart.items
        if it.product.metafields.custom.made_to_order.value == true or it.product.type contains 'Jacket'
          assign cart_mto = true
          break
        endif
      endfor
    -%}
    {%- if cart_mto -%}
      <div class="cd__fine">Shipping &amp; taxes calculated at checkout · <b>Paid online at checkout</b> — your cart contains a made-to-order piece, so card or JazzCash only</div>
    {%- else -%}
      <div class="cd__fine">Shipping &amp; taxes calculated at checkout · Cash on delivery available</div>
    {%- endif -%}
    <a class="cd__co" href="/checkout">Checkout →</a>
    <a class="cd__view" href="{{ routes.cart_url }}">View full cart</a>
    <div class="cd__trust">
      <span><svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Secure checkout</span>
      {%- comment -%}
        "7-day returns" is NOT true of made-to-order pieces — Returns &
        Exchanges says they are non-returnable once production has begun. Do not
        show that badge on an MTO cart; promise the lifetime warranty instead,
        which IS true of every piece.
      {%- endcomment -%}
      {%- if cart_mto -%}
        <span><svg viewBox="0 0 24 24"><path d="M12 2 4 6v6c0 5 8 8 8 8s8-3 8-8V6z"/><path d="m9 12 2 2 4-4"/></svg>Lifetime warranty</span>
      {%- else -%}
        <span><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>7-day returns</span>
        <span><svg viewBox="0 0 24 24"><rect x="1" y="4" width="15" height="12"/><path d="M16 8h4l3 3v5h-7z"/></svg>COD available</span>
      {%- endif -%}
    </div>
    <div class="cd__pay">{%- unless cart_mto -%}<span>COD</span>{%- endunless -%}<span>Visa</span><span>Mastercard</span><span>JazzCash</span></div>
  </div>

</aside>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    { "type": "collection", "id": "upsell_collection", "label": "Cross-sell collection", "info": "Products suggested in the cart drawer. Defaults to kdv-accessories." }
  ]
}
{% endschema %}
