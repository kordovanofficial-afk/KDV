<section class="kv-home kv-section">
  <div class="kv-wrap">
    <div class="kv-shead">
      <span class="kv-eyebrow">{{ section.settings.eyebrow | default: 'Bestsellers' }}</span>
      <h2>{{ section.settings.title | default: 'Customer Favourites' }}</h2>
    </div>

    <div class="kv-pgrid">
      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.handle] -%}
        {%- assign product = coll.products.first -%}
        {%- if product != blank -%}
          <a class="kv-card" href="{{ product.url }}" {{ block.shopify_attributes }}>
            <div class="kv-card__m">
              {%- if block.settings.label != blank -%}<span class="kv-card__tag">#1 in {{ block.settings.label }}</span>{%- endif -%}
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 640 }}" alt="{{ product.title | escape }}" width="640" height="800" loading="lazy">
              {%- endif -%}
              <div class="kv-card__atc">Add to Cart</div>
            </div>
            <div class="kv-card__n">{{ product.title | truncate: 46 }}</div>
            <div class="kv-card__meta">
              <span class="kv-card__p">{{ product.price | money }}</span>
              <span class="kv-card__s">★★★★★</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div style="text-align:center;margin-top:54px">
        <a class="kv-btn-text" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_text }} →</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bestsellers",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Customer Favourites" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "View All Products" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "category",
      "name": "Category #1",
      "settings": [
        { "type": "text", "id": "handle", "label": "Collection handle", "info": "e.g. kv2-mens-wallets — set that collection's sort order to 'Best selling' so its top product auto-updates here." },
        { "type": "text", "id": "label", "label": "Badge label", "info": "e.g. Wallets — shows as '#1 in Wallets'" }
      ]
    }
  ]
}
{% endschema %}
