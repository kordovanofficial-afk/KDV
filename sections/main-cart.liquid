{%- if cart.item_count > 0 -%}
<section class="section section--sm">
  <div class="container">
    <h1 style="margin-bottom:var(--space-8);">Your Bag <span style="font-size:var(--text-xl); font-family:var(--font-body); font-weight:400; color:var(--color-text-muted);">({{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }})</span></h1>

    <form action="{{ routes.cart_url }}" method="post" class="cart-page__form">
      <div class="cart-page__grid">

        <!-- Items -->
        <div class="cart-page__items">
          {%- for item in cart.items -%}
            <div class="cart-page__item" data-line="{{ forloop.index }}">
              <a href="{{ item.url }}" style="flex-shrink:0;">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 200 }}"
                    srcset="{{ item.image | image_url: width: 100 }} 100w, {{ item.image | image_url: width: 200 }} 200w, {{ item.image | image_url: width: 300 }} 300w"
                    sizes="100px"
                    decoding="async"
                    alt="{{ item.image.alt | escape }}"
                    width="100"
                    height="120"
                    loading="lazy"
                    style="width:100px; height:120px; object-fit:cover;"
                  >
                {%- endif -%}
              </a>
              <div style="flex:1; min-width:0;">
                <a href="{{ item.url }}" class="cart-page__item-title">{{ item.product.title }}</a>
                {%- unless item.variant.title == 'Default Title' -%}
                  <p style="font-size:var(--text-sm); color:var(--color-text-muted); margin-bottom:var(--space-2);">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p style="font-size:var(--text-sm); color:var(--color-text-muted); margin-bottom:var(--space-4);">SKU: {{ item.sku | default: 'N/A' }}</p>
                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:var(--space-3);">
                  <div class="qty-stepper">
                    <button type="button" class="qty-stepper__btn cart-page-qty" data-line="{{ forloop.index }}" data-action="minus" aria-label="Decrease">−</button>
                    <input
                      type="number"
                      name="updates[{{ item.key }}]"
                      value="{{ item.quantity }}"
                      min="0"
                      class="qty-stepper__input"
                      data-line="{{ forloop.index }}"
                      aria-label="Quantity for {{ item.product.title }}"
                    >
                    <button type="button" class="qty-stepper__btn cart-page-qty" data-line="{{ forloop.index }}" data-action="plus" aria-label="Increase">+</button>
                  </div>
                  <div style="display:flex; align-items:center; gap:var(--space-4);">
                    <span style="font-weight:700; font-size:var(--text-base);">{{ item.final_line_price | money_without_trailing_zeros }}</span>
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="cart-page__remove" aria-label="Remove {{ item.product.title }}">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M18 6 6 18M6 6l12 12"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Summary -->
        <aside class="cart-page__summary">
          <h2 style="font-size:var(--text-xl); margin-bottom:var(--space-6);">Order Summary</h2>

          <div style="display:flex; justify-content:space-between; margin-bottom:var(--space-3); font-size:var(--text-sm);">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money_without_trailing_zeros }}</span>
          </div>
          <div style="display:flex; justify-content:space-between; margin-bottom:var(--space-3); font-size:var(--text-sm); color:var(--color-text-muted);">
            <span>Shipping</span>
            <span>Calculated at checkout</span>
          </div>

          {%- if cart.total_price < 300000 -%}
            <div style="background:var(--color-bg-muted); border-radius:var(--radius-sm); padding:var(--space-3); margin-bottom:var(--space-4); font-size:var(--text-sm);">
              Add <strong>{{ 300000 | minus: cart.total_price | money_without_trailing_zeros }}</strong> more for free delivery
              <div style="background:var(--color-border); border-radius:100px; height:4px; margin-top:var(--space-2);">
                <div style="background:var(--color-primary); height:4px; border-radius:100px; width:{{ cart.total_price | times: 100 | divided_by: 300000 }}%;"></div>
              </div>
            </div>
          {%- else -%}
            <div style="background:#F0FDF4; border-radius:var(--radius-sm); padding:var(--space-3); margin-bottom:var(--space-4); font-size:var(--text-sm); color:#166534;">
              ✓ You qualify for free delivery!
            </div>
          {%- endif -%}

          <div style="border-top:1px solid var(--color-border); padding-top:var(--space-4); margin-bottom:var(--space-5);">
            <div style="display:flex; justify-content:space-between; font-weight:700; font-size:var(--text-lg);">
              <span>Total</span>
              <span>{{ cart.total_price | money_without_trailing_zeros }}</span>
            </div>
            <p style="font-size:var(--text-xs); color:var(--color-text-muted); margin-top:var(--space-1);">Taxes included where applicable</p>
          </div>

          <a href="/checkout" class="btn btn--primary btn--full btn--lg" style="margin-bottom:var(--space-3);">
            Proceed to Checkout →
          </a>
          <button type="submit" name="update" class="btn btn--secondary btn--full" style="margin-bottom:var(--space-4);">
            Update Cart
          </button>
          <a href="/collections/all" class="footer__link" style="display:block; text-align:center; font-size:var(--text-sm);">← Continue Shopping</a>

          <!-- Trust -->
          <div style="margin-top:var(--space-6); padding-top:var(--space-6); border-top:1px solid var(--color-border);">
            <div style="display:flex; flex-direction:column; gap:var(--space-3);">
              <div style="display:flex; align-items:center; gap:var(--space-3); font-size:var(--text-sm); color:var(--color-text-muted);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                100% secure checkout
              </div>
              <div style="display:flex; align-items:center; gap:var(--space-3); font-size:var(--text-sm); color:var(--color-text-muted);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.95"/></svg>
                7-day hassle-free returns
              </div>
              <div style="display:flex; align-items:center; gap:var(--space-3); font-size:var(--text-sm); color:var(--color-text-muted);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- liquid
                  assign cart_mto = false
                  for it in cart.items
                    if it.product.metafields.custom.made_to_order.value == true or it.product.type contains 'Jacket'
                      assign cart_mto = true
                      break
                    endif
                  endfor
                -%}
                {%- if cart_mto -%}Prepaid only — made-to-order piece in cart{%- else -%}COD available at checkout{%- endif -%}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </form>
  </div>
</section>

{%- else -%}
<section class="section">
  <div class="container" style="text-align:center; padding-block:var(--space-24);">
    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--color-border)" stroke-width="1" style="margin-inline:auto; margin-bottom:var(--space-6);">
      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/>
    </svg>
    <h1 style="margin-bottom:var(--space-4);">Your Bag is Empty</h1>
    <p style="color:var(--color-text-muted); margin-bottom:var(--space-8);">Looks like you haven't added anything yet. Let's change that.</p>
    <a href="/collections/all" class="btn btn--primary btn--lg">Shop All Products</a>
  </div>
</section>
{%- endif -%}

<style>
  .cart-page__grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-12);
    align-items: start;
  }
  .cart-page__item {
    display: flex;
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .cart-page__item-title {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    color: var(--color-text);
    display: block;
    margin-bottom: var(--space-1);
    text-decoration: none;
  }
  .cart-page__item-title:hover { color: var(--color-primary); }
  .cart-page__remove { color: var(--color-text-muted); display:flex; align-items:center; }
  .cart-page__remove:hover { color: var(--color-text); }
  .cart-page__summary {
    background: var(--color-bg-muted);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    position: sticky;
    top: 100px;
  }
  .qty-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .qty-stepper__btn {
    background: none;
    border: none;
    width: 36px;
    height: 36px;
    cursor: pointer;
    font-size: var(--text-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
  }
  .qty-stepper__btn:hover { background: var(--color-border); }
  .qty-stepper__input {
    width: 48px;
    text-align: center;
    border: none;
    border-left: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
    height: 36px;
    font-size: var(--text-sm);
    background: var(--color-bg);
  }
  @media (max-width: 900px) {
    .cart-page__grid { grid-template-columns: 1fr; }
    .cart-page__summary { position: static; }
  }
</style>

{% schema %}
{
  "name": "Cart",
  "settings": [],
  "presets": [{ "name": "Cart" }]
}
{% endschema %}
