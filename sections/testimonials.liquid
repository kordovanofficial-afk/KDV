<section class="section testimonials">
  <div class="container">
    <div class="section-header fade-in">
      <p class="eyebrow" style="color: var(--color-gold);">{{ section.settings.eyebrow | default: 'Customer Love' }}</p>
      <h2 style="color: var(--color-text-light);">{{ section.settings.title | default: 'What Our Customers Say' }}</h2>
    </div>

    <div class="testimonials-slider">
      {%- for block in section.blocks -%}
        <div class="testimonial-card fade-in" {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- for i in (1..5) -%}
              <svg class="star" viewBox="0 0 24 24" aria-hidden="true" style="color: {% if i <= block.settings.rating %}var(--color-gold){% else %}rgba(250,248,245,0.2){% endif %};">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/>
              </svg>
            {%- endfor -%}
          </div>
          <p class="testimonial-card__text">"{{ block.settings.text }}"</p>
          <div class="testimonial-card__author">
            <div class="testimonial-card__avatar" aria-hidden="true">
              {{ block.settings.name | slice: 0 }}
            </div>
            <div>
              <p class="testimonial-card__name">{{ block.settings.name }}</p>
              <p class="testimonial-card__meta">{{ block.settings.location }}{%- if block.settings.product != blank %} · {{ block.settings.product }}{%- endif %}</p>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer Love" },
    { "type": "text", "id": "title", "label": "Title", "default": "What Our Customers Say" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review text", "default": "Best leather wallet I have ever owned. The quality is exceptional and it only gets better with age." },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Ahmed K." },
        { "type": "text", "id": "location", "label": "City", "default": "Karachi" },
        { "type": "text", "id": "product", "label": "Product bought", "default": "KODO Smart Wallet" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "text": "I have had my KODO wallet for 2 years and it has developed the most beautiful patina. You can literally see the character building. Worth every rupee.",
            "name": "Usman R.",
            "location": "Lahore",
            "product": "KODO Smart Wallet"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "text": "Ordered the Executive Briefcase and it arrived beautifully packaged. The leather smell alone tells you this is genuine quality. My colleagues ask about it daily.",
            "name": "Bilal H.",
            "location": "Islamabad",
            "product": "Executive Briefcase"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "text": "Bought 3 wallets as gifts — Mocha Mate, The Access, and the Snap Card. Each one was perfect. Kordovan has become my go-to for gifting.",
            "name": "Sara M.",
            "location": "Karachi",
            "product": "Mocha Mate Wallet"
          }
        }
      ]
    }
  ]
}
{% endschema %}
