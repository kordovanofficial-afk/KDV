# Copy this file to ".env" and fill it in. Never commit the real .env.

# Make up a long random password. The SAME value goes into the Cloudflare Worker.
BRIDGE_SECRET=change-me-to-a-long-random-string

# Where replies get forwarded. Leave exactly as-is.
WORKER_INBOUND=https://kordovan-postex-sync.kordovan-official.workers.dev/wa-inbound

# Keep this separate from the POS bot's auth folder.
AUTH_DIR=./auth
PORT=8787
