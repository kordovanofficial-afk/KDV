# Copy this file to ".env" and fill it in. Never share or commit the real .env.

# 1) Long random password. The SAME value goes into the Cloudflare Worker.
BRIDGE_SECRET=change-me-to-a-long-random-string

# 2) A DIFFERENT random password. Used only to open the /qr and /status pages
#    in a browser. Separate so the send secret never appears in a URL or history.
ADMIN_KEY=change-me-to-another-random-string

# 3) Where customer replies get forwarded. Leave exactly as-is.
WORKER_INBOUND=https://kordovan-postex-sync.kordovan-official.workers.dev/wa-inbound

AUTH_DIR=./auth
PORT=8787
