{%- if section.settings.show_bar -%}
<div class="announcement-bar" role="region" aria-label="Announcement">
  <div class="announcement-bar__track">
    {%- for block in section.blocks -%}
      <span class="announcement-bar__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </span>
      {%- unless forloop.last -%}
        <span class="announcement-bar__divider" aria-hidden="true">·</span>
      {%- endunless -%}
    {%- endfor -%}
  </div>
  {%- if section.settings.show_close -%}
    <button class="announcement-bar__close" aria-label="Close announcement">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M1 1l12 12M13 1L1 13"/>
      </svg>
    </button>
  {%- endif -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    { "type": "checkbox", "id": "show_bar", "label": "Show announcement bar", "default": true },
    { "type": "checkbox", "id": "show_close", "label": "Show close button", "default": true }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free delivery on orders over PKR 3,000" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "🚚 Free Delivery on orders over PKR 3,000" } },
        { "type": "announcement", "settings": { "text": "✋ Handcrafted in Pakistan — Genuine Leather Guaranteed" } },
        { "type": "announcement", "settings": { "text": "💬 Need help? Chat with us on WhatsApp" } }
      ]
    }
  ]
}
{% endschema %}
