<div class="page-header">
  <div class="container">
    <h1>{{ page.title }}</h1>
  </div>
</div>

<section class="section section--sm">
  <div class="container">
    <div class="rte" style="max-width: 800px; margin-inline: auto;">
      {{ page.content }}
    </div>
  </div>
</section>

<style>
  .page-header {
    background: var(--color-bg-muted);
    padding-block: var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }
  .page-header h1 { margin: 0; }
  .rte { line-height: 1.8; }
  .rte h2, .rte h3 { margin-top: var(--space-8); margin-bottom: var(--space-3); }
  .rte p { margin-bottom: var(--space-4); }
  .rte ul, .rte ol { padding-left: var(--space-6); margin-bottom: var(--space-4); }
  .rte li { margin-bottom: var(--space-2); }
  .rte a { color: var(--color-primary); text-decoration: underline; }
  .rte img { max-width: 100%; border-radius: var(--radius-md); }
</style>

{% schema %}
{
  "name": "Page",
  "settings": [],
  "presets": [{ "name": "Page" }]
}
{% endschema %}
