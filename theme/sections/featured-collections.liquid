<section class="section section--sm">
  <div class="container">
    {%- if section.settings.title != blank -%}
      <div class="section-header fade-in">
        <p class="eyebrow">{{ section.settings.eyebrow | default: 'Shop By Category' }}</p>
        <h2>{{ section.settings.title }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="lead">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collections-grid collections-grid--featured">
      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.collection] -%}
        {%- assign block_image = block.settings.image | default: coll.image -%}
        {%- assign block_size = block.settings.size | default: 'medium' -%}

        <a
          href="{{ coll.url | default: block.settings.url | default: '/collections/all' }}"
          class="collection-card collection-card--{{ block_size }} fade-in"
          {{ block.shopify_attributes }}
        >
          <div class="collection-card__media">
            {%- if block_image -%}
              <img
                src="{{ block_image | img_url: '1200x' }}"
                srcset="{{ block_image | img_url: '600x' }} 600w, {{ block_image | img_url: '1200x' }} 1200w"
                sizes="{% if block_size == 'large' %}(max-width: 900px) 100vw, 58vw{% else %}(max-width: 900px) 100vw, 42vw{% endif %}"
                alt="{{ block.settings.title | default: coll.title | escape }}"
                loading="lazy"
                width="1200"
                height="{% if block_size == 'large' %}900{% else %}600{% endif %}"
              >
            {%- else -%}
              <div style="background: linear-gradient(135deg, #3D2B1F, #8B5E3C); width:100%; height:100%;"></div>
            {%- endif -%}
          </div>
          <div class="collection-card__overlay"></div>
          <div class="collection-card__content">
            {%- if block.settings.label != blank -%}
              <p class="collection-card__label">{{ block.settings.label }}</p>
            {%- endif -%}
            <h3 class="collection-card__title">{{ block.settings.title | default: coll.title }}</h3>
            <span class="collection-card__cta">
              {{ block.settings.cta | default: 'Shop Now' }}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Shop By Category" },
    { "type": "text", "id": "title", "label": "Section title", "default": "Crafted for Every Chapter" },
    { "type": "text", "id": "subtitle", "label": "Subtitle" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides collection image)" },
        { "type": "text", "id": "title", "label": "Title (overrides collection title)" },
        { "type": "text", "id": "label", "label": "Label tag", "default": "New Arrivals" },
        { "type": "text", "id": "cta", "label": "CTA text", "default": "Shop Now" },
        { "type": "url", "id": "url", "label": "Link (if no collection selected)" },
        {
          "type": "select",
          "id": "size",
          "label": "Card size",
          "options": [
            { "value": "large", "label": "Large (spans 7 columns)" },
            { "value": "medium", "label": "Medium (spans 5 columns)" }
          ],
          "default": "medium"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        { "type": "collection", "settings": { "title": "Wallets", "label": "Bestseller", "size": "large", "cta": "Shop Wallets" } },
        { "type": "collection", "settings": { "title": "Bags & Briefcases", "label": "Premium", "size": "medium", "cta": "Shop Bags" } },
        { "type": "collection", "settings": { "title": "Leather Jackets", "label": "Limited", "size": "medium", "cta": "Shop Jackets" } },
        { "type": "collection", "settings": { "title": "Caps & Accessories", "label": "New In", "size": "large", "cta": "Shop Accessories" } }
      ]
    }
  ]
}
{% endschema %}
