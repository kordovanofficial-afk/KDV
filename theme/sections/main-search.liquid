<div class="collection-header">
  <div class="container">
    {%- if search.performed -%}
      <p class="eyebrow">Search Results</p>
      <h1>
        {%- if search.results_count == 0 -%}
          No results for "{{ search.terms }}"
        {%- else -%}
          {{ search.results_count }} result{{ search.results_count | pluralize: '', 's' }} for "{{ search.terms }}"
        {%- endif -%}
      </h1>
    {%- else -%}
      <h1>Search</h1>
    {%- endif -%}

    <form action="{{ routes.search_url }}" method="get" class="search-form" style="margin-top:var(--space-6); max-width:560px; display:flex; gap:var(--space-3);">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search products..."
        class="form-input"
        style="flex:1;"
        aria-label="Search"
      >
      <input type="hidden" name="type" value="product">
      <button type="submit" class="btn btn--primary">Search</button>
    </form>
  </div>
</div>

{%- if search.performed and search.results_count > 0 -%}
  <section class="section section--sm">
    <div class="container">
      <div class="product-grid">
        {%- paginate search.results by 24 -%}
          {%- for result in search.results -%}
            {%- if result.object_type == 'product' -%}
              <div class="fade-in">
                {% render 'product-card', product: result %}
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- if paginate.pages > 1 -%}
            <div class="pagination" style="grid-column:1/-1; display:flex; justify-content:center; gap:var(--space-2); margin-top:var(--space-12);">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="btn btn--secondary btn--sm">← Previous</a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="btn btn--secondary btn--sm">{{ part.title }}</a>
                {%- else -%}
                  <span class="btn btn--primary btn--sm" aria-current="page">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="btn btn--secondary btn--sm">Next →</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </section>
{%- elsif search.performed -%}
  <section class="section section--sm">
    <div class="container" style="text-align:center; padding-block:var(--space-16);">
      <p style="color:var(--color-text-muted); margin-bottom:var(--space-6);">Try a different keyword, or browse our collections.</p>
      <a href="/collections/all" class="btn btn--primary">Shop All Products</a>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Search",
  "settings": [],
  "presets": [{ "name": "Search" }]
}
{% endschema %}
