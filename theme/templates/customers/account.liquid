{% layout 'theme' %}

<section class="section">
  <div class="container" style="max-width:800px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-10);">
      <div>
        <p class="eyebrow">Welcome back</p>
        <h1>{{ customer.first_name | default: customer.email }}</h1>
      </div>
      <a href="{{ routes.account_logout_url }}" class="btn btn--secondary btn--sm">Log Out</a>
    </div>

    <h2 style="margin-bottom:var(--space-6);">Order History</h2>
    {%- if customer.orders.size > 0 -%}
      <table style="width:100%; border-collapse:collapse; font-size:var(--text-sm);">
        <thead>
          <tr style="border-bottom:2px solid var(--color-border);">
            <th style="text-align:left; padding-bottom:var(--space-3); font-weight:600;">Order</th>
            <th style="text-align:left; padding-bottom:var(--space-3); font-weight:600;">Date</th>
            <th style="text-align:left; padding-bottom:var(--space-3); font-weight:600;">Status</th>
            <th style="text-align:right; padding-bottom:var(--space-3); font-weight:600;">Total</th>
          </tr>
        </thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr style="border-bottom:1px solid var(--color-border);">
              <td style="padding-block:var(--space-4);">
                <a href="{{ order.customer_url }}" style="color:var(--color-primary); font-weight:600;">{{ order.name }}</a>
              </td>
              <td style="padding-block:var(--space-4); color:var(--color-text-muted);">{{ order.created_at | date: '%b %d, %Y' }}</td>
              <td style="padding-block:var(--space-4);">{{ order.fulfillment_status | capitalize }}</td>
              <td style="padding-block:var(--space-4); text-align:right; font-weight:600;">{{ order.total_price | money_without_trailing_zeros }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <p style="color:var(--color-text-muted); margin-bottom:var(--space-6);">You haven't placed any orders yet.</p>
      <a href="/collections/all" class="btn btn--primary">Start Shopping</a>
    {%- endif -%}
  </div>
</section>
