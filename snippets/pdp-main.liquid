{%- comment -%}
  Product page — Quiet Heritage design (ported from docs/mockups/product.html).
  Styling = .kv-pdp in assets/home.css. Functional class hooks (.product-gallery,
  .product-form, .variant-btn, .product-atc__*, price els, [data-product-variants])
  are preserved so the existing theme.js gallery/variant/add-to-cart/cart-drawer
  logic keeps working untouched.

  Curated, per-product content reads from metafields and is hidden when empty
  (to be populated during the SEO pass). Brand-universal fallbacks keep the page
  looking complete in the meantime. No review app — reviews are self-authored via
  the `reviews` / `custom.reviews` metafields.
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign rmeta = product.metafields.reviews.rating.value
  assign rating_num = rmeta.rating | default: rmeta
  assign on_sale = false
  if v.compare_at_price > v.price
    assign on_sale = true
  endif
  assign wa = '923332601161'
-%}

<section class="kv-pdp">
  <div class="kv-wrap">
    <div class="crumb"><a href="{{ routes.root_url }}">Home</a> / {% if product.collections.first %}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> / {% endif %}{{ product.title }}</div>
  </div>

  <!-- ABOVE THE FOLD -->
  <div class="kv-wrap"><div class="kv-pdp__top">

    <!-- GALLERY -->
    <div class="product-gallery">
      <div class="product-gallery__thumbs">
        {%- for media in product.media limit: 12 -%}
          {%- comment -%}
            data-full-srcset lets the swap reuse a resolution the browser may
            already hold, instead of always fetching a fresh 900px file.
          {%- endcomment -%}
          <div class="product-gallery__thumb{% if forloop.first %} active{% endif %}"
               data-full="{{ media.preview_image | image_url: width: 900, format: 'webp' }}"
               data-full-srcset="{{ media.preview_image | image_url: width: 500, format: 'webp' }} 500w, {{ media.preview_image | image_url: width: 700, format: 'webp' }} 700w, {{ media.preview_image | image_url: width: 900, format: 'webp' }} 900w, {{ media.preview_image | image_url: width: 1200, format: 'webp' }} 1200w">
            <img src="{{ media.preview_image | image_url: width: 152, format: 'webp' }}"
                 srcset="{{ media.preview_image | image_url: width: 76, format: 'webp' }} 76w, {{ media.preview_image | image_url: width: 152, format: 'webp' }} 152w, {{ media.preview_image | image_url: width: 228, format: 'webp' }} 228w"
                 sizes="76px"
                 alt="{{ media.alt | escape | default: product.title | escape }}"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async" width="76" height="92">
          </div>
        {%- endfor -%}
      </div>
      <div class="product-gallery__main">
        {%- if v.available -%}<span class="kv-pdp__badge">In stock</span>{%- endif -%}
        {%- comment -%} LCP element on every PDP — eager, high priority, responsive. {%- endcomment -%}
        <img id="product-main-image"
             src="{{ product.featured_image | image_url: width: 900, format: 'webp' }}"
             srcset="{{ product.featured_image | image_url: width: 500, format: 'webp' }} 500w,
                     {{ product.featured_image | image_url: width: 700, format: 'webp' }} 700w,
                     {{ product.featured_image | image_url: width: 900, format: 'webp' }} 900w,
                     {{ product.featured_image | image_url: width: 1200, format: 'webp' }} 1200w"
             sizes="(max-width: 900px) 94vw, 46vw"
             alt="{{ product.featured_image.alt | escape | default: product.title | escape }}"
             loading="eager" fetchpriority="high" decoding="async" width="900" height="1125">
      </div>
    </div>

    <!-- BUY BOX -->
    <div class="kv-pdp__buy">
      <span class="eyebrow">{{ product.type | default: 'Kordovan' }}{% if product.metafields.custom.material != blank %} · {{ product.metafields.custom.material }}{% endif %}</span>
      <h1>{{ product.title }}</h1>
      {%- if product.metafields.custom.subtitle != blank -%}
        <p class="kv-pdp__sub">{{ product.metafields.custom.subtitle }}</p>
      {%- endif -%}

      {%- if product.metafields.reviews.rating != blank -%}
        <div class="kv-pdp__rate"><span class="stars">★★★★★</span> <b>{{ rating_num }}</b> · <a href="#reviews">{{ product.metafields.reviews.rating_count | default: 0 }} reviews</a></div>
      {%- endif -%}

      <div class="kv-pdp__price product-info__price">
        <span class="product-info__price-current{% if on_sale %} is-sale{% endif %}">{{ v.price | money }}</span>
        <span class="product-info__price-compare"{% unless on_sale %} style="display:none"{% endunless %}>{{ v.compare_at_price | money }}</span>
        {%- if on_sale -%}{%- assign pct = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
          <span class="product-info__price-save">Save {{ pct }}%</span>
        {%- else -%}<span class="product-info__price-save" style="display:none"></span>{%- endif -%}
        <span class="kv-pdp__tax">Inclusive of all taxes</span>
      </div>

      <ul class="kv-pdp__bul">
        {%- if product.metafields.custom.benefits != blank -%}
          {%- assign bens = product.metafields.custom.benefits | newline_to_br | split: '<br />' -%}
          {%- for b in bens -%}{%- assign bt = b | strip -%}{%- if bt != blank -%}
            <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>{{ bt }}</li>
          {%- endif -%}{%- endfor -%}
        {%- else -%}
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Full-grain leather that ages beautifully with use</li>
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Hand-finished for a seam that won't fray</li>
          <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Backed by our lifetime craftsmanship warranty</li>
        {%- endif -%}
      </ul>

      <!-- FORM (theme.js hooks preserved) -->
      <form class="product-form" action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="id" value="{{ v.id }}">
        <script type="application/json" data-product-variants>{{ product.variants | json }}</script>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="product-variants" data-option-index="{{ forloop.index0 }}">
              <div class="product-variants__label">{{ option.name }}: <span class="product-variants__selected">{{ option.selected_value }}</span></div>
              <div class="product-variants__options">
                {%- for value in option.values -%}
                  <button type="button" class="variant-btn{% if option.selected_value == value %} active{% endif %}" data-value="{{ value | escape }}" aria-label="{{ option.name }}: {{ value }}">{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="kv-pdp__buyrow">
          <div class="product-atc__quantity product-atc__qty" aria-label="Quantity">
            <button type="button" class="product-atc__qty-btn" data-action="minus" aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" class="product-atc__qty-input" value="1" min="1" aria-label="Quantity">
            <button type="button" class="product-atc__qty-btn" data-action="plus" aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" class="product-atc__add"{% unless v.available %} disabled{% endunless %}>{% if v.available %}Add to Cart · {{ v.price | money }}{% else %}Sold Out{% endif %}</button>
        </div>
        {%- if shop.enabled_payment_types != blank -%}
          <div class="kv-pdp__buynow-wrap" style="margin-top:12px">{{ form | payment_button }}</div>
        {%- endif -%}
      </form>

      <div class="kv-pdp__trust3">
        <div><svg viewBox="0 0 24 24"><path d="M12 2 4 6v6c0 5 8 8 8 8s8-3 8-8V6z"/><path d="m9 12 2 2 4-4"/></svg><span>100% genuine<br>leather</span></div>
        <div><svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg><span>Free delivery<br>over PKR 5,500</span></div>
        <div><svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9 9 0 0 0-6.4 2.6L3 8"/><path d="M3 3v5h5"/></svg><span>7-day easy<br>returns</span></div>
      </div>

      <div class="kv-pdp__ship"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><div><b>Order today, dispatched in 1–2 days.</b> Cash on delivery available nationwide. Delivered in 2–6 business days.</div></div>
      <a class="kv-pdp__wa" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2z"/></svg>Questions? Chat with us on WhatsApp</a>
    </div>

  </div></div>

  <!-- WHY IT'S DIFFERENT (brand-universal) -->
  <section class="kv-pdp__sec kv-pdp__sec--parch"><div class="kv-wrap">
    <div class="kv-pdp__shead"><span class="eyebrow">Why You'll Carry It for Years</span><h2>Built to a higher standard.</h2></div>
    <div class="kv-pdp__feat">
      <div><svg viewBox="0 0 24 24"><path d="M12 2 4 6v6c0 5 8 8 8 8s8-3 8-8V6z"/></svg><h3>Genuine Leather</h3><p>Real hides, honestly tanned — leather that resists wear and ages into a rich, personal patina.</p></div>
      <div><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg><h3>Considered Design</h3><p>Functional, minimal, and made to be used every single day.</p></div>
      <div><svg viewBox="0 0 24 24"><path d="M12 2v20M5 7l7-5 7 5M5 7v10l7 5 7-5V7"/></svg><h3>Hand-Stitched</h3><p>Stitched and finished by hand so the seams never fray or pull apart.</p></div>
      <div><svg viewBox="0 0 24 24"><path d="M12 2 4 6v6c0 5 8 8 8 8s8-3 8-8V6z"/><path d="m9 12 2 2 4-4"/></svg><h3>Lifetime Warranty</h3><p>If it fails because of how it was made, we repair or replace it.</p></div>
    </div>
  </div></section>

  <!-- FITS / CAPACITY (per-product, metafield-driven; hidden until set) -->
  {%- if product.metafields.custom.fits != blank -%}
    {%- assign fits = product.metafields.custom.fits | newline_to_br | split: '<br />' -%}
    <section class="kv-pdp__sec"><div class="kv-wrap"><div class="kv-pdp__fits">
      {%- liquid
        # prefer a wide/landscape shot (the lifestyle image) for this band
        assign fits_img = blank
        for im in product.images
          if fits_img == blank and im.aspect_ratio > 1.2
            assign fits_img = im
          endif
        endfor
        if fits_img == blank
          assign fits_img = product.media[1].preview_image | default: product.featured_image
        endif
      -%}
      <div class="img"><img src="{{ fits_img | image_url: width: 1000 }}" srcset="{{ fits_img | image_url: width: 600 }} 600w, {{ fits_img | image_url: width: 1000 }} 1000w, {{ fits_img | image_url: width: 1400 }} 1400w" sizes="(max-width:900px) 94vw, 50vw" alt="{{ fits_img.alt | escape | default: product.title | escape }}" loading="lazy" decoding="async" width="1000" height="750"></div>
      <div>
        {%- comment -%}
          Eyebrow is per-product because this band is no longer wallets-only.
          "Holds What Matters" is wallet language and reads wrong above a hat,
          a jacket or a belt. Defaults to the original string, so every product
          that does not set custom.fits_eyebrow renders exactly as before.
        {%- endcomment -%}
        <span class="eyebrow">{{ product.metafields.custom.fits_eyebrow | default: "Holds What Matters" | escape }}</span>
        <h2>{{ product.metafields.custom.fits_title | default: "Everything you need. Nothing you don't." }}</h2>
        {%- if product.metafields.custom.fits_text != blank -%}<p>{{ product.metafields.custom.fits_text }}</p>{%- endif -%}
        <div class="kv-pdp__fitsg">
          {%- for f in fits limit: 3 -%}{%- assign parts = f | strip | split: '|' -%}{%- if parts[0] != blank -%}
            <div class="kv-pdp__fitst"><div class="n">{{ parts[0] | strip }}</div><div class="l">{{ parts[1] | strip }}</div></div>
          {%- endif -%}{%- endfor -%}
        </div>
      </div>
    </div></div></section>
  {%- endif -%}

  <!-- DESCRIPTION + tabs -->
  <section class="kv-pdp__sec"><div class="kv-wrap"><div class="kv-pdp__desc">
    <div class="rte">{{ product.description }}</div>
    <div class="kv-pdp__acc">
      <details open><summary>Leather Care</summary><div class="b">Wipe with a soft, dry cloth, condition every 4–6 weeks, and keep out of prolonged sun and water. See our full <a href="/pages/leather-care-guide">Leather Care Guide</a>.</div></details>
      <details><summary>Shipping &amp; Returns</summary><div class="b">Dispatched in 1–2 business days; delivered in 2–6 days. Free delivery over PKR 5,500. Cash on delivery nationwide. 7-day returns on unused items — see <a href="/pages/returns">Returns &amp; Exchanges</a>.</div></details>
      <details><summary>Our Warranty</summary><div class="b">Every Kordovan piece carries a lifetime craftsmanship warranty. If it fails because of how it was made, we repair or replace it. <a href="/pages/about-kordovan">More about us</a>.</div></details>
    </div>
  </div></div></section>

  <!-- REVIEWS (self-authored; hidden until a rating metafield is set) -->
  {%- if product.metafields.reviews.rating != blank -%}
    <section class="kv-pdp__sec kv-pdp__sec--parch" id="reviews"><div class="kv-wrap">
      <div class="kv-pdp__shead"><span class="eyebrow">Reviews</span><h2>What customers say.</h2></div>
      <div class="kv-pdp__rev">
        <div class="kv-pdp__revsum">
          <div class="kv-pdp__revbig">{{ rating_num }}</div>
          <span class="stars">★★★★★</span>
          <div class="kv-pdp__revcnt">Based on {{ product.metafields.reviews.rating_count | default: 0 }} verified reviews</div>
        </div>
        <div class="kv-pdp__revlist">
          {%- assign revs = product.metafields.custom.reviews | newline_to_br | split: '<br />' -%}
          {%- for r in revs -%}{%- assign p = r | strip | split: '|' -%}{%- if p[2] != blank -%}
            <div class="kv-pdp__rcard">
              <div class="top"><span class="stars">★★★★★</span><span class="v"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Verified Purchase</span></div>
              <div class="by">{{ p[0] | strip }} <span>· {{ p[1] | strip }}</span></div>
              <p>{{ p[2] | strip }}</p>
            </div>
          {%- endif -%}{%- endfor -%}
        </div>
      </div>
    </div></section>
  {%- endif -%}

  <!-- GUARANTEE -->
  <section class="kv-pdp__guar"><div class="kv-wrap">
    <span class="eyebrow">Our Promise</span>
    <h2>Backed for life — <em>built to be handed down.</em></h2>
    <p>Every Kordovan piece carries a lifetime craftsmanship warranty. If it fails because of how it was made, we'll repair or replace it. No questions asked.</p>
  </div></section>

  <!-- STICKY MOBILE ATC -->
  <div class="kv-pdp__mbar"><span class="mp">{{ v.price | money }}</span><button type="button" onclick="document.querySelector('.kv-pdp .product-atc__add')?.click()">Add to Cart</button></div>
</section>
{% render 'pdp-jsonld' %}
