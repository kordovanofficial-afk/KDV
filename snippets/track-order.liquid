{%- comment -%}
  Designed "Track Your Order" page body (handle: track-order). Styling = .kv-cp
  plus the .kv-track block in home.css.

  The footer link used to point at routes.account_url, which bounces a logged-out
  visitor into Shopify's login flow — that was the "page keeps loading" report.

  Live status comes from our own Cloudflare Worker (kordovan-postex-sync), which
  already holds the PostEx token for the COD auto-payment sync. Setting
  `settings.tracking_api_url` to its /track endpoint turns on the in-page modal.

  Fallback order, so the page is never a dead end:
    1. tracking_api_url set  → live status in a modal (best)
    2. courier_tracking_url  → opens the courier's own page in a new tab
    3. neither               → WhatsApp with the number pre-filled

  The Worker returns ONLY status/city/timestamps — never name, phone, address or
  order value. See tools/postex-worker/track-endpoint.js for why that matters.
{%- endcomment -%}
{%- liquid
  assign wa = settings.whatsapp_number | default: '923332601161' | replace: '+', '' | replace: ' ', ''
  assign courier = settings.courier_tracking_url
  assign api = settings.tracking_api_url
  assign courier_name = settings.courier_name | default: 'our courier'
-%}
<div class="kv-cp">

  <section class="phead">
    <div class="wrap">
      <span class="eyebrow">Order Tracking</span>
      <h1>Where's my order?</h1>
      <p>Enter the tracking number from your confirmation message and we'll take you straight to its live status.</p>
    </div>
  </section>

  <section class="sec sec--tight"><div class="wrap wrap--narrow">
    <form class="kv-track" id="kv-track"
          data-api="{{ api | escape }}"
          data-courier="{{ courier | escape }}"
          data-wa="{{ wa }}">
      <label for="kv-track-no">Tracking number</label>
      <div class="kv-track__row">
        <input type="text" id="kv-track-no" name="tracking" inputmode="latin"
               autocomplete="off" placeholder="e.g. 1234567890" required>
        <button type="submit">Track →</button>
      </div>
      <p class="kv-track__hint">It's in your WhatsApp order-confirmation message and your dispatch email.</p>
      <p class="kv-track__err" id="kv-track-err" hidden>Please enter your tracking number first.</p>
    </form>

    <div class="kv-track__alt">
      <p><b>Don't have your tracking number?</b> Send us your order number and we'll look it up.</p>
      <a class="kv-track__wa" href="https://wa.me/{{ wa }}?text={{ 'Hi Kordovan, I would like to track my order. My order number is ' | url_encode }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2z"/></svg>
        Ask on WhatsApp
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="kv-track__acct" href="{{ routes.account_url }}">Or sign in to see your order history</a>
      {%- endif -%}
    </div>
  </div></section>

  <section class="sec sec--tight"><div class="wrap wrap--narrow">
    <div class="shead"><span class="eyebrow">What the statuses mean</span><h2>From our bench to your door.</h2></div>
    <table class="tbl">
      <tr><th>Status</th><th>What's happening</th></tr>
      <tr><td><b>Order received</b></td><td>We have your order and are picking it from stock.</td></tr>
      <tr><td><b>Dispatched</b></td><td>Handed to {{ courier_name }}. Tracking goes live within a few hours.</td></tr>
      <tr><td><b>In transit</b></td><td>On its way to your city's delivery hub.</td></tr>
      <tr><td><b>Out for delivery</b></td><td>With the rider today. Keep your phone reachable — riders call before arriving.</td></tr>
      <tr><td><b>Delivered</b></td><td>Handed over and paid. Enjoy it.</td></tr>
    </table>
    <p style="text-align:center;margin-top:20px;color:var(--stone);font-size:14px">
      Orders are dispatched within 1–2 business days. If tracking hasn't updated in 48 hours, message us — we'll chase it for you.
    </p>
  </div></section>

  <!-- STATUS MODAL -->
  <div class="kv-tm" id="kv-tm" hidden>
    <div class="kv-tm__ov" data-close></div>
    <div class="kv-tm__box" role="dialog" aria-modal="true" aria-labelledby="kv-tm-h">
      <button class="kv-tm__x" type="button" aria-label="Close" data-close>&times;</button>
      <div class="kv-tm__body" id="kv-tm-body"></div>
      <a class="kv-tm__wa" id="kv-tm-wa" href="#" target="_blank" rel="noopener">Need help? Message us on WhatsApp</a>
    </div>
  </div>

</div>

<script>
(function(){
  var f=document.getElementById('kv-track');
  if(!f) return;
  var err=document.getElementById('kv-track-err');
  var modal=document.getElementById('kv-tm');
  var body=document.getElementById('kv-tm-body');
  var waLink=document.getElementById('kv-tm-wa');
  var wa=f.getAttribute('data-wa');
  var api=(f.getAttribute('data-api')||'').trim();
  var courier=(f.getAttribute('data-courier')||'').trim();

  function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }

  function open(html,no){
    body.innerHTML=html;
    waLink.href='https://wa.me/'+wa+'?text='+encodeURIComponent('Hi Kordovan, I need help with my order. Tracking number: '+no);
    modal.hidden=false;
    document.body.style.overflow='hidden';
  }
  function close(){ modal.hidden=true; document.body.style.overflow=''; }
  modal.addEventListener('click',function(e){ if(e.target.hasAttribute('data-close')) close(); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape'&&!modal.hidden) close(); });

  function fmt(d){
    if(!d) return '';
    var t=new Date(d);
    if(isNaN(t)) return esc(d);
    return t.toLocaleString('en-PK',{day:'numeric',month:'short',hour:'numeric',minute:'2-digit'});
  }

  function render(data,no){
    if(!data||!data.ok){
      // Heading must match the actual failure. Saying "Not found yet" when our
      // own service is unreachable tells the customer their number is wrong,
      // which is both untrue and unhelpful.
      var code=(data&&data.error)||'unreachable';
      var head=code==='not_found' ? 'Not found yet'
             : code==='invalid_number' ? 'Check that number'
             : "We can't reach tracking";
      var msg=(data&&data.message)||'Our tracking service is not responding right now. Your order is unaffected — message us and we will check it for you.';
      return open('<div class="kv-tm__state kv-tm__state--warn">'+
        '<h3 id="kv-tm-h">'+esc(head)+'</h3><p>'+esc(msg)+'</p></div>',no);
    }
    var h='<div class="kv-tm__head"><span class="kv-tm__no">'+esc(data.trackingNumber)+'</span>'+
          '<h3 id="kv-tm-h">'+esc(data.status||'In progress')+'</h3>'+
          (data.city?'<p class="kv-tm__city">'+esc(data.city)+'</p>':'')+
          (data.updatedAt?'<p class="kv-tm__upd">Updated '+fmt(data.updatedAt)+'</p>':'')+
          '</div>';
    if(data.history&&data.history.length){
      h+='<ol class="kv-tm__tl">';
      for(var i=data.history.length-1;i>=0;i--){
        var s=data.history[i];
        h+='<li'+(i===data.history.length-1?' class="on"':'')+'><b>'+esc(s.status)+'</b>'+
           (s.at?'<span>'+fmt(s.at)+'</span>':'')+'</li>';
      }
      h+='</ol>';
    }
    open(h,no);
  }

  f.addEventListener('submit',function(e){
    e.preventDefault();
    var no=(document.getElementById('kv-track-no').value||'').trim();
    if(!no){ if(err) err.hidden=false; return; }
    if(err) err.hidden=true;

    // 1. Live status via our Worker (preferred).
    if(api){
      var btn=f.querySelector('button[type=submit]'), label=btn.textContent;
      btn.disabled=true; btn.textContent='Checking…';
      var target=api+(api.indexOf('?')===-1?'?':'&')+'cn='+encodeURIComponent(no);
      fetch(target,{headers:{'Accept':'application/json'}})
        .then(function(r){ return r.json().catch(function(){ return null; }); })
        .then(function(d){ render(d,no); })
        .catch(function(e){
          // Network-level failure: wrong Worker URL, Worker offline, or CORS.
          // Surfaced in the console so the URL actually being called is visible.
          console.error('[kv-track] could not reach tracking API:',target,e);
          render({ok:false,error:'unreachable'},no);
        })
        .then(function(){ btn.disabled=false; btn.textContent=label; });
      return;
    }
    // 2. Courier's own page.
    if(courier){
      var url=courier.indexOf('{number}')!==-1
        ? courier.replace('{number}',encodeURIComponent(no))
        : courier+encodeURIComponent(no);
      window.open(url,'_blank','noopener'); return;
    }
    // 3. WhatsApp — never leave the customer with nothing.
    window.open('https://wa.me/'+wa+'?text='+encodeURIComponent('Hi Kordovan, please track my order. Tracking number: '+no),'_blank','noopener');
  });
})();
</script>
